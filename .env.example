# Copy to .env and replace placeholders. Never commit .env.
POSTGRES_DB=golocal
POSTGRES_USER=golocal
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432
# Match these credentials to the values above; URL-encode special characters.
DATABASE_URL=postgresql://golocal:replace_with_a_local_password@localhost:5432/golocal
# Leave API settings empty until the embeddings / LLM phases.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
